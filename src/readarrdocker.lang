# ===========================================================================
# Multilingual file for the TOS 7 Docker application "readarrdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Readarr"
auth         = "Readarr"
version      = "@@VERSION@@"
descript     = "Readarr is a book manager for Usenet and BitTorrent: it monitors authors and books, grabs releases and renames the files for your library. This package runs the LinuxServer Docker Hub image as a non-root container with a small wrapper that starts the Readarr binary directly."
release_note = "1. First release."
important    = "Open the web UI and set up your download client and indexers, then add the books folder. Data lives in /Volume1/DockerAppData/readarrdocker/ and survives restarts and updates. The container runs as uid 1000. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "Readarr"
auth         = "Readarr"
version      = "@@VERSION@@"
descript     = "习惯打卡与连续天数统计，界面简洁。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/beaverhabitsdocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

