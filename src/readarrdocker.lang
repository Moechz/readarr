# ===========================================================================
# Multilingual file for the TOS 7 Docker application "readarrdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Readarr"
auth         = "Readarr"
version      = "@@VERSION@@"
descript     = "Readarr is a book manager for Usenet and BitTorrent: it monitors authors, grabs releases from your indexers, imports them from your download client and files them into a library folder. The package runs the official LinuxServer image as a non-root container with persistent /config, /books and /downloads folders. Upstream Readarr is archived, so the application itself stays at version 0.3.10."
release_note = "1. Privacy policy, licence notice and a full third-party disclosure (metadata service, update check, your indexers, download clients and notification providers). 2. Persistent /books and /downloads folders, so the library and the import step actually work. 3. Chinese descriptions rewritten - the previous text belonged to another application. 4. Config files are created with umask 077. 5. Readarr upstream is archived: the image stays pinned to its last published build and the package documents the vulnerability position in PRIVACY.md and the README."
important    = "Requires DockerEngine. Open the WebUI on port 8091, add an indexer and a download client, set the root folder to /books and point the client's completed folder at /downloads. The WebUI has no password by default - enable authentication in Settings > General before exposing it. Data lives in DockerAppData/readarrdocker/. Upstream Readarr is archived (no further releases); the app talks to readarr.servarr.com (update check) and api.bookinfo.club (metadata). Privacy policy: https://www.moechz.com/privacy.html"

[zh-cn]
name         = "Readarr"
auth         = "Readarr"
version      = "@@VERSION@@"
descript     = "Readarr 是一款图书管理工具：监控作者与书目，从你配置的索引器抓取资源，通过下载客户端下载后自动整理、重命名并归档到书库目录。本应用使用 LinuxServer 官方镜像，以非 root 容器运行，并提供 /config、/books、/downloads 三个持久化目录。上游 Readarr 已归档，应用本身停留在 0.3.10 版本。"
release_note = "1. 新增隐私政策、许可声明与完整的第三方披露（元数据服务、更新检查、索引器、下载客户端、通知服务）。2. 新增 /books 与 /downloads 持久化目录，书库与导入功能真正可用。3. 重写中文文案（原先是别的应用的文案）。4. 配置文件以 umask 077 创建。5. 上游 Readarr 已归档：镜像锁定在最后一个发布版本，漏洞状况在 PRIVACY.md 与 README 中说明。"
important    = "需要 DockerEngine。打开 8091 端口的界面，添加索引器与下载客户端，把根目录设为 /books，并把下载客户端的完成目录指向 /downloads。界面默认无密码，对局域网暴露前请在「设置 > 常规」里开启身份验证。数据在 DockerAppData/readarrdocker/。上游 Readarr 已归档不再更新；应用会访问 readarr.servarr.com（检查更新）与 api.bookinfo.club（元数据）。隐私政策：https://www.moechz.com/privacy.html"

[zh-hk]
name         = "Readarr"
auth         = "Readarr"
version      = "@@VERSION@@"
descript     = "Readarr 是一款圖書管理工具：監控作者與書目，從你設定的索引器抓取資源，透過下載用戶端下載後自動整理、重新命名並歸檔到書庫目錄。本應用使用 LinuxServer 官方映像，以非 root 容器運行，並提供 /config、/books、/downloads 三個持久化目錄。上游 Readarr 已封存，應用本身停留在 0.3.10 版本。"
release_note = "1. 新增隱私政策、授權聲明與完整的第三方披露（中繼資料服務、更新檢查、索引器、下載用戶端、通知服務）。2. 新增 /books 與 /downloads 持久化目錄，書庫與匯入功能真正可用。3. 重寫中文文案（原先是別的應用的文案）。4. 設定檔以 umask 077 建立。5. 上游 Readarr 已封存：映像鎖定在最後一個發佈版本，漏洞狀況在 PRIVACY.md 與 README 中說明。"
important    = "需要 DockerEngine。開啟 8091 埠的介面，新增索引器與下載用戶端，把根目錄設為 /books，並把下載用戶端的完成目錄指向 /downloads。介面預設無密碼，對區域網路暴露前請在「設定 > 一般」裡開啟身分驗證。資料在 DockerAppData/readarrdocker/。上游 Readarr 已封存不再更新；應用會存取 readarr.servarr.com（檢查更新）與 api.bookinfo.club（中繼資料）。隱私政策：https://www.moechz.com/privacy.html"

